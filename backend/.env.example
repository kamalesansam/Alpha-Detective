# Alpha Detective backend configuration.
# Copy this file to backend/.env and fill in what you need.
#
# IMPORTANT: keep every comment on its OWN line. A trailing comment after an
# empty value (KEY=  # note) is parsed as the value itself by python-dotenv,
# which silently breaks startup. Values below are intentionally bare.

# Free key: https://aistudio.google.com/apikey
# Leave empty for retrieval-only mode (search works, no generated answers).
GOOGLE_API_KEY=

# auto | gemini | none
# auto   = use Gemini if a valid key is present, otherwise retrieval-only.
# gemini = require Gemini; fail loudly at startup if it is unavailable.
# none   = retrieval-only, never call the provider.
PROVIDER=auto

# auto = first available of: gemini-flash-latest, gemini-2.5-flash, gemini-2.0-flash
GEMINI_LLM_MODEL=auto

# auto = first available of: gemini-embedding-001, gemini-embedding-2-preview
GEMINI_EMBED_MODEL=auto

# on | off -- local cross-encoder rerank stage
RERANK=on

# --- deployment (v1.2) -------------------------------------------------------
# Port to listen on. Presence of PORT in the environment ALSO selects the bind
# host: set means 0.0.0.0 (a PaaS is dictating the port), unset means 127.0.0.1.
# A value here (as opposed to a real environment variable) never flips the
# bind host: only an exported PORT does, which is what a PaaS provides.
PORT=8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Quota gate for a public URL: when non-empty, every /api route except
# /api/health requires the header X-Access-Code with this value.
# It is a quota gate, not a password: the browser has to know it.
ACCESS_CODE=

# Max LLM calls per UTC day. Over budget, queries degrade to extractive
# answers with degraded_reason "daily_budget" -- retrieval never stops.
# 0 disables generation entirely.
DAILY_LLM_BUDGET=200

# Per-IP requests per 60s on POST /api/query, POST /api/documents and
# DELETE /api/documents/{id}. GET routes are exempt. 0 disables the throttle.
RATE_LIMIT_PER_MIN=10

# How many rightmost X-Forwarded-For entries come from proxies you control.
# 0 (default) ignores the header and uses the socket peer -- correct locally.
# Set to 1 behind exactly one PaaS proxy (Render). Never guess high: an
# over-count lets a client pick its own rate-limit bucket, or burn someone
# else's.
TRUSTED_PROXY_HOPS=0

# Total corpus cap. Uploads past it fail per file; duplicates never count.
MAX_DOCUMENTS=50

# on | off -- index backend/sample_data/ at startup when the manifest is empty.
AUTO_SEED=on
