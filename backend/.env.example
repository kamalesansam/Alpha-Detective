# Alpha Detective backend configuration.
# Copy this file to backend/.env and fill in what you need.
#
# IMPORTANT: keep every comment on its OWN line. A trailing comment after an
# empty value (KEY=  # note) is parsed as the value itself by python-dotenv,
# which silently breaks startup. Values below are intentionally bare.

# Free key: https://aistudio.google.com/apikey
# Leave empty for retrieval-only mode (search works, no generated answers).
GOOGLE_API_KEY=

# auto | gemini | none
# auto   = use Gemini if a valid key is present, otherwise retrieval-only.
# gemini = require Gemini; fail loudly at startup if it is unavailable.
# none   = retrieval-only, never call the provider.
PROVIDER=auto

# auto = first available of: gemini-flash-latest, gemini-2.5-flash, gemini-2.0-flash
GEMINI_LLM_MODEL=auto

# auto = first available of: gemini-embedding-001, gemini-embedding-2-preview
GEMINI_EMBED_MODEL=auto

# on | off -- local cross-encoder rerank stage
RERANK=on
